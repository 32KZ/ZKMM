<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ZK Mod Menu (ZKMM), a Celeste mod for the Everest mod loader.

    Put this folder in Celeste/Mods/ and build; the game's own files are found two folders up.
    To build somewhere else, pass the game folder:  dotnet build -c Release -p:CelestePrefix=/path/to/Celeste
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>ZKModMenu</AssemblyName>
    <RootNamespace>ZKModMenu</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>bin\</OutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <DebugType>portable</DebugType>
    <CelestePrefix Condition="'$(CelestePrefix)' == '' And Exists('..\..\Celeste.dll')">..\..</CelestePrefix>
    <CelestePrefix Condition="'$(CelestePrefix)' == ''">lib-stripped</CelestePrefix>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Source\**\*.cs" />
  </ItemGroup>

  <!-- The game's files are only needed to compile. They are never copied or shipped. -->
  <ItemGroup>
    <Reference Include="Celeste">
      <HintPath>$(CelestePrefix)\Celeste.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FNA">
      <HintPath>$(CelestePrefix)\FNA.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="YamlDotNet">
      <HintPath>$(CelestePrefix)\YamlDotNet.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
